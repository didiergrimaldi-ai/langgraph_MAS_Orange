# Copia este archivo como .env y rellena tus claves. Nunca subas .env a GitHub.

# Obligatorias
OPENAI_API_KEY=
TAVILY_API_KEY=
VIRUSTOTAL_API_KEY=

# Gmail (OAuth de Google Cloud): el credentials.json descargado y el token que se crea la primera vez
GOOGLE_APPLICATION_CREDENTIALS=credenciales_google.json
GMAIL_TOKEN=token.json

# A quién notifica el SOC
SOC_EMAIL_RECIPIENT=
SOC_EMAIL_SENDER=

# Opcional: si lo defines, la app de Streamlit pide esta contraseña
APP_PASSWORD=
