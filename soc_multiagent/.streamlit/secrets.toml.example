# Plantilla para Streamlit Community Cloud (App → Settings → Secrets).
# Copia este contenido allí con tus valores. NO subas secrets.toml a GitHub.

OPENAI_API_KEY = "sk-..."
TAVILY_API_KEY = "tvly-..."
VIRUSTOTAL_API_KEY = "..."
SOC_EMAIL_RECIPIENT = "soc@tuempresa.com"
SOC_EMAIL_SENDER = "tu-cuenta@gmail.com"

# Recomendado en una app pública: evita que cualquiera gaste tus créditos y envíe emails
APP_PASSWORD = "elige-una-contraseña"

# Gmail: pega el CONTENIDO de tu token.json (generado en local con probar_alerta.py)
GMAIL_TOKEN_JSON = '''
{"token": "...", "refresh_token": "...", "token_uri": "https://oauth2.googleapis.com/token", "client_id": "...", "client_secret": "...", "scopes": ["https://www.googleapis.com/auth/gmail.compose"]}
'''

# Opcional: contenido de credenciales_google.json (solo se usa si el token no vale)
# GOOGLE_CREDENTIALS_JSON = '''{"installed": {...}}'''
